---
import Layout from '@layouts/Layout.astro';
import ContactForm from '@components/react/ContactForm';
---

<Layout color="bg-gradient-to-r from-white via-slate-50 to-slate-200 dark:from-black dark:via-white/[0.05] dark:to-white/[0.08]" title="Contacto | Luis Osorio">
  <div class="flex justify-center w-full py-16">
    <div class="w-full max-w-2xl px-2">
      <header class="flex flex-col items-center text-center mb-10 fade-in">
        <h1 class="text-4xl md:text-5xl font-bold text-slate-900 dark:text-white mb-3">Contacto</h1>
        <p class="text-lg text-slate-500 dark:text-slate-400">¿Tienes un proyecto o idea? Hablemos</p>
      </header>

      <div class="fade-in-up stagger-1">
        <ContactForm client:load />
      </div>
    </div>
  </div>
</Layout>

<style>
  @import '../styles/animations.css';
</style>
