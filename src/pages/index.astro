---
import Layout from '@layouts/Layout.astro';

import Introduction from '@components/index/introduction.astro'
import Experience from '@components/index/experience.astro'
import TechProjects from '@components/react/TechProjects.tsx';
import { techs } from '@lib/tech';
import { projects } from '@lib/projects';
---

<Layout color="bg-gradient-to-r from-white via-slate-50 to-slate-200 dark:from-black dark:via-white/[0.05] dark:to-white/[0.08]" title="Luis Osorio | luisfosg">
  <div class="flex flex-col w-full justify-center items-center">
    <Introduction />
    <TechProjects client:load techs={techs} projects={projects} />
    <Experience />
  </div>
</Layout>

