---
interface Props {
  href?: string;
  isActive?: boolean;
}

const { href, isActive = false } = Astro.props
---

<li>
  <a
    onclick="window.dispatchEvent(new Event('close-menu'))"
    class:list={[
      "flex gap-3 rounded-lg font-medium p-3 items-center transition-colors duration-150",
      isActive
        ? "bg-slate-300 text-slate-900 dark:bg-zinc-700 dark:text-zinc-100"
        : "text-slate-600 hover:text-slate-600 hover:bg-slate-300 dark:text-zinc-400 dark:hover:bg-zinc-700 dark:hover:text-zinc-100"
    ]}
    href={href}
  >
    <slot />
  </a>
</li>
