---
import { Image } from 'astro:assets';
---

<a onclick="window.dispatchEvent(new Event('close-menu'))" href="/profile" class="flex justify-between w-full rounded-lg border-slate-600 hover:bg-slate-300 dark:bg-zinc-900 cursor-pointer dark:hover:bg-zinc-800/40 p-3 transition-colors duration-150">
  <div class="flex justify-center items-center gap-4">
    <Image class="ml-2 rounded-full" width="50" height="50" src="/images/avatar.png" alt="luisfosg" loading="lazy" />

    <div class="flex flex-col justify-center">
      <strong class="text-lg dark:text-white">Luis Osorio</strong>
      <span class="text-sm text-slate-500 dark:text-zinc-400">luisfosg</span>
    </div>
  </div>
</a>
